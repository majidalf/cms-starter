NEXT_PUBLIC_SANITY_PROJECT_ID={{SANITY_PROJECT_ID}}
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Public origin of the site, no trailing slash. Used for canonical and hreflang URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Use 'staging' instead of 'production' above for a sandbox dataset that doesn't
# affect the live site.

# Only needed once a Sanity webhook is configured against this app's deployed
# /api/revalidate URL. Generate when creating the webhook at sanity.io/manage;
# put the real value in .env.local / .dev.vars, never here.
SANITY_REVALIDATE_SECRET=

# Public Cloudflare Turnstile site key, used by the contact form widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public Cloudflare Web Analytics site token. When empty, the beacon script
# is not rendered. Copy the token from the Cloudflare dashboard
# (Websites > your site > Web Analytics) into .env.local / .dev.vars.
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# Contact form delivery (server-only, put real values in .env.local / .dev.vars).
# TURNSTILE_SECRET_KEY verifies the spam-check token, RESEND_API_KEY sends the
# email, CONTACT_TO_EMAIL receives it, CONTACT_FROM_EMAIL must be a verified
# sender in Resend (e.g. "Site Name <noreply@example.com>").
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
